# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_INPUT_CHARS=8000

# Google Calendar (OAuth 2.0). Credenciales de tipo "Aplicación web" en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback
# 32 bytes en base64. Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
